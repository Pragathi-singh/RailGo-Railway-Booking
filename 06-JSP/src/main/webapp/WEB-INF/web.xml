<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
  <display-name>RailGo JSP</display-name>
  <filter><filter-name>encoding</filter-name><filter-class>com.railgo.jsp.filter.EncodingFilter</filter-class></filter><filter-mapping><filter-name>encoding</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter><filter-name>auth</filter-name><filter-class>com.railgo.jsp.filter.AuthFilter</filter-class></filter><filter-mapping><filter-name>auth</filter-name><url-pattern>/dashboard</url-pattern></filter-mapping><filter-mapping><filter-name>auth</filter-name><url-pattern>/history</url-pattern></filter-mapping><filter-mapping><filter-name>auth</filter-name><url-pattern>/profile</url-pattern></filter-mapping>
  <servlet>
    <servlet-name>railgoStatic</servlet-name>
    <servlet-class>org.apache.catalina.servlets.DefaultServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>railgoStatic</servlet-name>
    <url-pattern>/assets/*</url-pattern>
  </servlet-mapping>
  <error-page><error-code>404</error-code><location>/WEB-INF/views/404.jsp</location></error-page>
  <welcome-file-list><welcome-file>home</welcome-file></welcome-file-list>
</web-app>
