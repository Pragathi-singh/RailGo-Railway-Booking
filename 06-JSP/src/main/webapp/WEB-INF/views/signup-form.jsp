<%@ taglib prefix="c" uri="jakarta.tags.core" %><form method="post" action="${pageContext.request.contextPath}/signup" class="auth-form" novalidate><input type="hidden" name="csrf" value="${csrf}"><c:forEach var="field" items="${['fullName','email','mobile','password','confirmPassword']}"><c:choose><c:when test="${field == 'fullName'}"><label class="field">Full name<input name="fullName" value="${fullName}" required><c:if test="${not empty errors.fullName}"><span class="error">${errors.fullName}</span></c:if></label></c:when><c:when test="${field == 'email'}"><label class="field">Email address<input type="email" name="email" value="${email}" required><c:if test="${not empty errors.email}"><span class="error">${errors.email}</span></c:if></label></c:when><c:when test="${field == 'mobile'}"><label class="field">Mobile number<input type="tel" name="mobile" value="${mobile}" placeholder="10-digit Indian mobile number" required><c:if test="${not empty errors.mobile}"><span class="error">${errors.mobile}</span></c:if></label></c:when><c:otherwise><label class="field">${field == 'password' ? 'Password' : 'Confirm password'}<input type="password" name="${field}" required><c:if test="${not empty errors[field]}"><span class="error">${errors[field]}</span></c:if></label></c:otherwise></c:choose></c:forEach><button class="button full" type="submit">Create account →</button></form><p class="auth-switch">Already have an account? <a href="${pageContext.request.contextPath}/login">Sign in</a></p>
