<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Booking history | RailGo</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><%@ include file="fragments/header.jspf" %><main class="dashboard container"><p class="eyebrow">YOUR JOURNEYS</p><h1>Booking history</h1><c:choose><c:when test="${empty bookings}"><section class="empty-state"><span class="empty-icon">⌁</span><h2>Your journeys will appear here</h2><p>You have no saved bookings yet.</p><a class="button" href="${pageContext.request.contextPath}/home#search">Search trains →</a></section></c:when><c:otherwise><div class="booking-list"><c:forEach var="booking" items="${bookings}"><article><h2>${booking.origin} → ${booking.destination}</h2><p>${booking.journeyDate} · ${booking.travelClass}</p></article></c:forEach></div></c:otherwise></c:choose></main><%@ include file="fragments/footer.jspf" %></body></html>
