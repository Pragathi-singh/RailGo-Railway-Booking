<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Search results | RailGo</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><%@ include file="fragments/header.jspf" %><main class="results container"><p class="eyebrow">SEARCH RESULTS</p><h1>Find your next journey.</h1><c:choose><c:when test="${not empty result}"><section class="empty-state"><span class="empty-icon">⌁</span><h2>No live train results are available right now</h2><p>${result}</p><a class="button" href="${pageContext.request.contextPath}/home#search">Search another route →</a></section></c:when><c:otherwise><section class="empty-state error-state"><h2>Please review your journey details</h2><c:forEach var="item" items="${errors}"><p class="error">${item.value}</p></c:forEach><a class="button" href="${pageContext.request.contextPath}/home#search">Edit search →</a></section></c:otherwise></c:choose></main><%@ include file="fragments/footer.jspf" %></body></html>
