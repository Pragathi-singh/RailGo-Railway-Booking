<%@ taglib prefix="c" uri="jakarta.tags.core" %><form method="post" action="${pageContext.request.contextPath}/login" class="auth-form" novalidate><input type="hidden" name="csrf" value="${csrf}"><c:if test="${not empty error}"><p class="alert" role="alert">${error}</p></c:if><label class="field">Email address<input type="email" name="email" autocomplete="email" required></label><label class="field">Password<div class="password"><input id="password" type="password" name="password" autocomplete="current-password" required><button type="button" data-password="#password">Show</button></div></label><button class="button full" type="submit">Sign in to RailGo →</button></form><p class="auth-switch">New to RailGo? <a href="${pageContext.request.contextPath}/signup">Create an account</a></p><p class="auth-switch"><a href="${pageContext.request.contextPath}/forgot-password">Forgot your password?</a></p>
