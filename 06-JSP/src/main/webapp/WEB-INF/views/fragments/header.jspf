<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<header class="site-header"><nav class="navbar container" aria-label="Main navigation">
  <a class="brand" href="${pageContext.request.contextPath}/home"><span class="brand-mark">R</span><span>Rail<span>Go</span></span></a>
  <div class="nav-links"><a href="${pageContext.request.contextPath}/home">Home</a><a href="${pageContext.request.contextPath}/home#search">Trains</a>
  <c:choose><c:when test="${not empty sessionScope.user}"><a href="${pageContext.request.contextPath}/dashboard">My account</a><a href="${pageContext.request.contextPath}/history">Bookings</a><form method="post" action="${pageContext.request.contextPath}/logout" class="inline-form"><input type="hidden" name="csrf" value="${csrf}"><button class="nav-logout" type="submit">Log out</button></form></c:when><c:otherwise><a href="${pageContext.request.contextPath}/login">Sign in</a><a class="button button--small" href="${pageContext.request.contextPath}/signup">Create account</a></c:otherwise></c:choose>
  </div></nav></header>
