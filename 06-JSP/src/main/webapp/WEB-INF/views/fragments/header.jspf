<%@ taglib prefix="c" uri="jakarta.tags.core"%>
<header class="site-header">
    <nav class="navbar container" aria-label="Main navigation">
        <a class="brand" href="/home"><span class="brand-mark">R</span><span>Rail<span>Go</span></span></a>
        <div class="nav-links"><a href="/home">Home</a><a href="/home#search">Trains</a>
            <c:choose>
                <c:when test=""><a href="/dashboard">My account</a><a href="/history">Bookings</a>
                    <form method="post" action="/logout" class="inline-form"><input type="hidden" name="csrf" value=""><button class="nav-logout" type="submit">Log out</button></form>
                </c:when>
                <c:otherwise><a href="/login">Sign in</a><a class="button button--small" href="/signup">Create account</a></c:otherwise>
            </c:choose>
        </div>
    </nav>
</header>
