<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My account | RailGo</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><%@ include file="fragments/header.jspf" %><main class="dashboard container"><p class="eyebrow">YOUR RAILGO ACCOUNT</p><h1>Welcome, ${sessionScope.user.fullName}.</h1><p class="muted">Keep your travel details together and plan your next journey.</p><section class="profile-card"><h2>Your profile</h2><dl><dt>Full name</dt><dd>${sessionScope.user.fullName}</dd><dt>Email</dt><dd>${sessionScope.user.email}</dd><dt>Mobile</dt><dd>${sessionScope.user.mobile}</dd></dl><div class="actions"><a class="button" href="${pageContext.request.contextPath}/home#search">Search trains</a><a class="button secondary" href="${pageContext.request.contextPath}/profile">Edit profile</a><a class="text-link" href="${pageContext.request.contextPath}/history">View booking history →</a></div></section></main><%@ include file="fragments/footer.jspf" %></body></html>
