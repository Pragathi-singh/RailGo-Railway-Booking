<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#102B46">
    <meta name="description" content="Discover RailGo and plan your next railway journey across India.">
    <title><%= title %> | RailGo</title>
    <link rel="stylesheet" href="<%= asset('css/style.css') %>">
    <script src="<%= asset('js/script.js') %>" defer></script>
</head>
<body>
<%- include('partials/header') %>
<main id="main-content">
    <% if (flash) { %>
        <div class="page-width landing-flashes"><p class="notice notice--<%= flash.type === 'success' ? 'success' : 'error' %>" role="status"><%= flash.message %></p></div>
    <% } %>
    <section class="hero" aria-labelledby="hero-title">
        <div class="hero__image" role="img" aria-label="Passenger train crossing the lush Konkan landscape in India"></div>
        <div class="hero__content page-width">
            <p class="eyebrow eyebrow--light">YOUR JOURNEY, OUR PRIORITY</p>
            <h1 id="hero-title">Explore India,<br>One Journey at a Time</h1>
            <p>Book train tickets with ease, comfort and confidence.</p>
            <a class="button button--outline" href="#search">Plan your journey <span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="hero__caption">Photo: Subumecher, <a href="https://commons.wikimedia.org/wiki/File:Konkan_Express.jpg" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a></div>
    </section>

    <section class="search-section page-width" id="search" aria-labelledby="search-title">
        <div class="search-panel">
            <div class="search-panel__heading">
                <div><p class="eyebrow">YOUR NEXT ADVENTURE</p><h2 id="search-title">Where would you like to go?</h2></div>
                <span class="demo-tag">DEMO SEARCH</span>
            </div>
            <% if (Object.keys(errors).length) { %>
                <div class="form-alert" role="alert">Please review the highlighted journey details.</div>
            <% } %>
            <% if (searchMessage) { %><p class="notice notice--info" role="status"><%= searchMessage %></p><% } %>
            <form action="/search" method="post" class="search-form" novalidate>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="station-fields">
                    <div class="field">
                        <label for="from">From station</label>
                        <input id="from" name="from" type="text" maxlength="120" placeholder="e.g. Mumbai Central" value="<%= search ? search.from || '' : '' %>" required aria-describedby="from-hint">
                        <% if (errors.from) { %><span class="field-error" id="from-hint"><%= errors.from %></span><% } else { %><span class="field-hint" id="from-hint">Your departure city or station</span><% } %>
                    </div>
                    <button type="button" class="swap-button" data-swap-stations aria-label="Swap departure and destination" title="Swap stations"><span aria-hidden="true">&#8644;</span></button>
                    <div class="field">
                        <label for="to">To station</label>
                        <input id="to" name="to" type="text" maxlength="120" placeholder="e.g. New Delhi" value="<%= search ? search.to || '' : '' %>" required aria-describedby="to-hint">
                        <% if (errors.to) { %><span class="field-error" id="to-hint"><%= errors.to %></span><% } else { %><span class="field-hint" id="to-hint">Where would you like to arrive?</span><% } %>
                    </div>
                </div>
                <div class="search-form__details">
                    <div class="field">
                        <label for="journey-date">Journey date</label>
                        <input id="journey-date" name="journeyDate" type="date" min="<%= new Date().toISOString().slice(0, 10) %>" value="<%= search ? search.journeyDate || '' : '' %>" required>
                        <% if (errors.journeyDate) { %><span class="field-error"><%= errors.journeyDate %></span><% } %>
                    </div>
                    <div class="field">
                        <label for="travel-class">Travel class</label>
                        <select id="travel-class" name="travelClass">
                            <% for (const travelClass of ['Sleeper', 'AC 3 Tier', 'AC 2 Tier', 'AC First Class', 'Chair Car']) { %>
                                <option value="<%= travelClass %>" <%= search && search.travelClass === travelClass ? 'selected' : '' %>><%= travelClass %></option>
                            <% } %>
                        </select>
                        <% if (errors.travelClass) { %><span class="field-error"><%= errors.travelClass %></span><% } %>
                    </div>
                    <button class="button search-submit" type="submit">Search Trains <span aria-hidden="true">&rarr;</span></button>
                </div>
            </form>
            <p class="demo-disclaimer">This college project does not connect to live schedules or ticket inventory.</p>
        </div>
    </section>

    <section class="benefits page-width" aria-labelledby="benefits-title">
        <div class="section-heading"><p class="eyebrow">THE RAILGO DIFFERENCE</p><h2 id="benefits-title">A little more ease in every journey</h2></div>
        <div class="benefit-grid">
            <article class="benefit"><span class="benefit__icon" aria-hidden="true">&#10003;</span><h3>Easy Booking</h3><p>A clear, simple experience from planning to your next stop.</p></article>
            <article class="benefit"><span class="benefit__icon" aria-hidden="true">&#9678;</span><h3>Live Train Status</h3><p>A planned RailGo benefit; live schedules are not connected in this demo.</p></article>
            <article class="benefit"><span class="benefit__icon" aria-hidden="true">&#9830;</span><h3>Multiple Payment Options</h3><p>Payment methods are not connected; this demo does not process payments.</p></article>
            <article class="benefit"><span class="benefit__icon" aria-hidden="true">&#9742;</span><h3>24/7 Support</h3><p>Support services are not connected in this local college demonstration.</p></article>
        </div>
    </section>

    <section class="why-section" id="why-railgo" aria-labelledby="why-title">
        <div class="why-section__inner page-width">
            <div class="why-section__image" role="img" aria-label="A passenger train passing through India's Konkan region"></div>
            <div class="why-section__copy">
                <p class="eyebrow">MORE THAN A TICKET</p>
                <h2 id="why-title">Your journey deserves a thoughtful start.</h2>
                <p>RailGo brings the essentials of planning together in one welcoming place. Get ready to discover new cities, reconnect with familiar places, and make the most of the miles in between.</p>
                <a class="text-link" href="/signup">Get started with RailGo <span aria-hidden="true">&rarr;</span></a>
                <p class="small-print">This is an authentication and interface demonstration, not a live booking service.</p>
                <p class="small-print" id="demo-terms">Demo terms: use sample information only. Accounts stay in memory and reset on restart; there are no live bookings, schedules, or payments.</p>
            </div>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
