<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
    <div class="site-header__inner">
        <a class="brand" href="/home" aria-label="RailGo home">
            <span class="brand__mark" aria-hidden="true">
                <svg viewBox="0 0 36 36" focusable="false">
                    <path d="M10 5h16a5 5 0 0 1 5 5v13a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5V10a5 5 0 0 1 5-5Z"/>
                    <path d="M11 11h14v8H11zM10 23h16M12 28l-3 4m15-4 3 4M11 8l-3-3m17 3 3-3"/>
                    <circle cx="12" cy="23" r="1.4"/><circle cx="24" cy="23" r="1.4"/>
                </svg>
            </span>
            <span class="brand__words">
                <span class="brand__name">Rail<span>Go</span></span>
                <span class="brand__tagline">Your Journey, Our Priority.</span>
            </span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
            <span class="sr-only">Toggle navigation</span><span></span><span></span><span></span>
        </button>
        <nav class="primary-nav" id="primary-navigation" aria-label="Main navigation">
            <a href="/home">Home</a>
            <a href="/home#search">Trains</a>
            <a href="/home#search">Bookings</a>
            <a href="/home#support">Help</a>
            <% if (currentUser) { %>
                <span class="nav-user">Hello, <%= currentUser.fullName %></span>
                <a href="/dashboard">My account</a>
                <form class="nav-logout" action="/logout" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="nav-link-button" type="submit">Log out</button>
                </form>
            <% } else { %>
                <a class="nav-login" href="/login">Login</a>
                <a class="button button--small" href="/signup">Sign Up</a>
            <% } %>
        </nav>
    </div>
</header>
