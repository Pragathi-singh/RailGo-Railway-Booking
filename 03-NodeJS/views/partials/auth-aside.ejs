<aside class="auth-aside">
    <div class="auth-aside__photo" aria-hidden="true"></div>
    <div class="auth-aside__content">
        <a class="brand brand--light" href="/home">
            <span class="brand__mark" aria-hidden="true">
                <svg viewBox="0 0 36 36" focusable="false">
                    <path d="M10 5h16a5 5 0 0 1 5 5v13a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5V10a5 5 0 0 1 5-5Z"/>
                    <path d="M11 11h14v8H11zM10 23h16M12 28l-3 4m15-4 3 4M11 8l-3-3m17 3 3-3"/>
                    <circle cx="12" cy="23" r="1.4"/><circle cx="24" cy="23" r="1.4"/>
                </svg>
            </span>
            <span class="brand__words"><span class="brand__name">Rail<span>Go</span></span><span class="brand__tagline">Your Journey, Our Priority.</span></span>
        </a>
        <div class="auth-aside__copy">
            <p class="eyebrow eyebrow--light">TRAVEL, MADE THOUGHTFUL</p>
            <h2><%= heading %></h2>
            <p class="auth-aside__description"><%= description %></p>
            <ul class="auth-highlights">
                <% highlights.forEach((highlight) => { %><li><span class="highlight-check" aria-hidden="true">&#10003;</span><%= highlight %></li><% }) %>
            </ul>
        </div>
        <% if (typeof quote === 'string' && quote) { %><blockquote class="travel-quote"><span aria-hidden="true">&ldquo;</span><%= quote %></blockquote><% } %>
        <p class="auth-aside__footnote">Your Journey, Our Priority.</p>
    </div>
</aside>
