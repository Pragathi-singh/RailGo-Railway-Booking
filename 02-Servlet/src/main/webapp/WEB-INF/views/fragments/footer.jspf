<footer class="site-footer" id="support">
    <div class="site-footer__main">
        <div class="footer-brand">
            <a class="brand brand--light" href="${pageContext.request.contextPath}/home">
                <span class="brand__mark" aria-hidden="true">
                    <svg viewBox="0 0 36 36" focusable="false">
                        <path d="M10 5h16a5 5 0 0 1 5 5v13a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5V10a5 5 0 0 1 5-5Z"/>
                        <path d="M11 11h14v8H11zM10 23h16M12 28l-3 4m15-4 3 4M11 8l-3-3m17 3 3-3"/>
                        <circle cx="12" cy="23" r="1.4"/><circle cx="24" cy="23" r="1.4"/>
                    </svg>
                </span>
                <span class="brand__words">
                    <span class="brand__name">Rail<span>Go</span></span>
                    <span class="brand__tagline">Your Journey, Our Priority.</span>
                </span>
            </a>
            <p>Thoughtful journeys begin with a simpler way to plan.</p>
        </div>
        <div class="footer-links">
            <h2>Quick Links</h2>
            <a href="${pageContext.request.contextPath}/home">Home</a>
            <a href="${pageContext.request.contextPath}/home#search">Search demo</a>
            <a href="${pageContext.request.contextPath}/login">My account</a>
        </div>
        <div class="footer-links">
            <h2>Support</h2>
            <a href="${pageContext.request.contextPath}/home#demo-terms">Demo terms</a>
            <a href="${pageContext.request.contextPath}/home#support">Project information</a>
            <a href="${pageContext.request.contextPath}/signup">Create account</a>
        </div>
    </div>
    <div class="site-footer__bottom">
        <span>&copy; <%= java.time.Year.now().getValue() %> RailGo. A college project demonstration.</span>
        <span>Demo only &middot; No live railway bookings or payments.</span>
    </div>
</footer>
</body>
</html>
