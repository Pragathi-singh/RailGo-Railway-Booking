<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.railgo.model.PublicUser,com.railgo.util.Html" %>
<%
    Object navUserValue = request.getAttribute("currentUser");
    PublicUser navUser = navUserValue instanceof PublicUser ? (PublicUser) navUserValue : null;
    String navName = navUser == null ? "" : Html.escape(navUser.fullName());
%>
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
    <div class="site-header__inner">
        <a class="brand" href="${pageContext.request.contextPath}/home" aria-label="RailGo home">
            <span class="brand__mark" aria-hidden="true">
                <svg viewBox="0 0 36 36" focusable="false">
                    <path d="M10 5h16a5 5 0 0 1 5 5v13a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5V10a5 5 0 0 1 5-5Z"/>
                    <path d="M11 11h14v8H11zM10 23h16M12 28l-3 4m15-4 3 4M11 8l-3-3m17 3 3-3"/>
                    <circle cx="12" cy="23" r="1.4"/><circle cx="24" cy="23" r="1.4"/>
                </svg>
            </span>
            <span class="brand__words">
                <span class="brand__name">Rail<span>Go</span></span>
                <span class="brand__tagline">Your Journey, Our Priority.</span>
            </span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
            <span class="sr-only">Toggle navigation</span><span></span><span></span><span></span>
        </button>
        <nav class="primary-nav" id="primary-navigation" aria-label="Main navigation">
            <a href="${pageContext.request.contextPath}/home">Home</a>
            <a href="${pageContext.request.contextPath}/home#search">Trains</a>
            <a href="${pageContext.request.contextPath}/home#search">Bookings</a>
            <a href="${pageContext.request.contextPath}/home#support">Help</a>
            <% if (navUser == null) { %>
                <a class="nav-login" href="${pageContext.request.contextPath}/login">Login</a>
                <a class="button button--small" href="${pageContext.request.contextPath}/signup">Sign Up</a>
            <% } else { %>
                <span class="nav-user">Hello, <%= navName %></span>
                <a href="${pageContext.request.contextPath}/dashboard">My account</a>
                <form class="nav-logout" action="${pageContext.request.contextPath}/logout" method="post">
                    <input type="hidden" name="csrfToken" value="<%= Html.escape((String) request.getAttribute("csrfToken")) %>">
                    <button class="nav-link-button" type="submit">Log out</button>
                </form>
            <% } %>
        </nav>
    </div>
</header>
